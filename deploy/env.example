# 复制为服务器上的 /opt/apps/fattura/.env
PORT=4385
HOST=127.0.0.1
ACCOUNTS=1
DATA_DIR=/opt/apps/fattura/data
TRUST_PROXY=1

# 注册需要邀请码（留空 = 任何人都能注册）
INVITE_CODE=

# 服务器统一提供 AI 识别：填 Anthropic API Key（留空 = 每个用户在「我的」里填自己的 Key）
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# 每个账号每天最多识别多少次
# RECOGNIZE_DAILY_LIMIT=100
